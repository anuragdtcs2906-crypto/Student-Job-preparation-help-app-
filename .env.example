# Application Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DEBUG=True

# Database Configuration (PostgreSQL in production, SQLite fallback supported for dev/test)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/communication_coach_db
# For SQLite local fallback: sqlite:///communication_coach.db

# JWT Configuration
JWT_SECRET_KEY=change-this-to-a-secure-jwt-secret-key-in-production
JWT_ACCESS_TOKEN_EXPIRES_DAYS=30

# AI Configuration (OpenAI SDK)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
AI_MOCK_FALLBACK=True

# CORS Configuration
CORS_ORIGINS=*
